# .env.example — SAFE TO COMMIT. Copy this file to .env.local and fill in
# real values there. Never put real production secrets in this file or in
# git — .env.local is already gitignored (see .gitignore).

# -----------------------------------------------------------------------------
# PUBLIC (safe to expose to the browser via Vite's VITE_ prefix)
#
# Vite inlines any env var prefixed VITE_ into the client-bundled JavaScript.
# Only put values here that are *designed* to be public. The Supabase anon
# key is public by design — real protection comes from Row Level Security on
# the database side (a later sprint), not from hiding this key.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# SECRET (server-only — NO VITE_ prefix, ever)
#
# These are read only by server-only code (src/config/env.ts's `serverEnv`,
# and later the server-only Supabase client / server functions built on top
# of it). A value here must never be renamed with a VITE_ prefix "to make it
# work" — that would ship it straight into the browser bundle.
# -----------------------------------------------------------------------------

# Same Supabase project URL as VITE_SUPABASE_URL above, but read from
# process.env on the server path rather than Vite's import.meta.env.
SUPABASE_URL=

# The service_role key from Supabase Settings -> API -> Project API keys.
# This is the master key: it bypasses Row Level Security entirely. If it
# ever ends up in a browser-visible file, a commit, or a chat log, rotate it
# immediately in Supabase (Settings -> API -> Reset).
SUPABASE_SERVICE_ROLE_KEY=
